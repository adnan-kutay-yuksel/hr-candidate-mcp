# Data source to use: mock | linkedin
CANDIDATE_PROVIDER=mock

# Cache TTL in seconds
CACHE_TTL_SECONDS=900

# --- linkedin provider (only for organizations with official LinkedIn API access) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_BASE=https://api.linkedin.com
LINKEDIN_TOKEN_URL=https://www.linkedin.com/oauth/v2/accessToken
LINKEDIN_API_VERSION=
# Endpoints provided under your partner agreement. "{id}" is replaced with the candidate ID.
LINKEDIN_SEARCH_PATH=
LINKEDIN_PROFILE_PATH=
